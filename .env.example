# Application Secret Key (auto-generated fallback exists for local dev, set a strong value in production)
SECRET_KEY=trustvault-local-dev-secret-key-change-in-production-9f8e7d6c5b4a
FLASK_DEBUG=0

# Database Mode:
# Option A (Zero-Setup Default): If DB_USER and DB_PASSWORD are left blank or not set,
# TrustVault automatically uses a local SQLite database at instance/trustvault.db.
# Option B (Oracle XE): Uncomment and fill in your Oracle XE credentials below:
# DB_USER=system
# DB_PASSWORD=your_oracle_password
# DB_HOST=localhost
# DB_PORT=1521
# DB_SERVICE=XE

# Optional: Only set ORACLE_CLIENT_DIR if you explicitly need Oracle Thick Mode.
# Leave commented/empty to use python-oracledb Thin Mode (no Instant Client needed!)
# ORACLE_CLIENT_DIR=C:\oracle\instantclient_21_13

# Local development only; set to 1 for HTTPS deployments
SESSION_COOKIE_SECURE=0
